# Copy to .env and fill in. Keys here stay on your computer; the phone never sees them.

# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# xAI Grok — https://console.x.ai
XAI_API_KEY=

# Optional: OpenJarvis running on this computer (`jarvis serve --port 8000`)
OPENJARVIS_URL=http://127.0.0.1:8000
OPENJARVIS_API_KEY=

# Recommended: a password the phone must send to use this server (enter it in Jarvis > Settings)
JARVIS_TOKEN=
